SPRING_PROFILES_ACTIVE=prod

# アプリケーション共通設定
SERVER_PORT=443
HTTP_PORT=80

# MySQL 接続情報（docker-compose の mysql サービス用）
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=internalbooks
MYSQL_USER=internalbooks
MYSQL_PASSWORD=change_me_app

# Spring Boot 側から利用するDB接続情報（必要に応じて application-prod.properties で参照）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=${MYSQL_DATABASE}
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}

# JWT シークレット（本番では強固なランダム文字列を設定すること）
JWT_SECRET=your-secure-random-secret

# AWS S3（本番で画像ストレージに S3 を使用する場合）
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_REGION=ap-northeast-1

# AWS 認証（基本はEC2インスタンスロールを使い、キー直書きは避ける）
# 必要な場合のみローカル検証用として利用
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# ============================================================================
# SSL/HTTPS設定（Let's Encrypt + Certbot）
# ============================================================================
# ドメイン名（Let's Encrypt証明書取得に必要）
DOMAIN_NAME=your-domain.com

# SSL有効化フラグ
SSL_ENABLED=true

# PKCS12キーストア設定
SSL_KEYSTORE_PATH=/opt/ssl/keystore.p12
SSL_KEYSTORE_PASSWORD=your-secure-keystore-password

# ============================================================================
# CloudFront CDN設定（S3画像のHTTPS配信用）
# ============================================================================
# CloudFront有効化フラグ
CLOUDFRONT_ENABLED=true

# CloudFrontディストリビューションURL
# 例: https://dxxxxxxxxxx.cloudfront.net
CLOUDFRONT_URL=https://your-distribution-id.cloudfront.net
